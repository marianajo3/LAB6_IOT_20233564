rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function valid() {
   let d = request.resource.data;
   return d.keys().hasAll(['device','group','date','value','notes'])
    && d.keys().hasOnly(['device','group','date','value','notes'])
    && d.device is string && d.device.size() > 0 && d.device.size() <= 60
    && d.group in ["Semillero", "Cultivo A", "Cultivo B"]
    && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.value is number && d.value >= -20 && d.value <= 80
    
    && d.notes is string && d.notes.size() <= 250;
  }
  match /users/{uid}/readings/{id} {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid) && valid();
  }
 }
}
