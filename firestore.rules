rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function valid() {
   let d = request.resource.data;
   return d.keys().hasAll(['course','date','hours','activity'])
    && d.keys().hasOnly(['course','date','hours','activity'])
    && d.course is string && d.course.size() > 0 && d.course.size() <= 100
    && d.course.matches('.*[^ ].*')
    && d.date is string && d.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
    && d.hours is number && d.hours > 0 && d.hours <= 24
    && d.activity in ['Teoría', 'Práctica', 'Laboratorio'];
  }
  match /users/{uid}/sessions/{id} {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid) && valid();
  }
 }
}
